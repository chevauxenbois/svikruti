{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            {
              "id": "javascript.lang.security.audit.detect-non-literal-fs-filename",
              "shortDescription": {
                "text": "Example static-analysis finding"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "javascript.lang.security.audit.detect-non-literal-fs-filename",
          "level": "warning",
          "message": {
            "text": "Example SARIF finding imported into Svikruti."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/realistic/insecure_controls.js"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
